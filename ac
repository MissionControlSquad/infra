#!/usr/bin/env bash
set -euo pipefail

# HOST_INFRA_DIR is used for docker compose --project-directory so paths
# resolve correctly even when running inside a container
INFRA_DIR="$(cd "$(dirname "$0")" && pwd)"
HOST_INFRA_DIR="${AC_HOST_DIR:-$INFRA_DIR}"
CLIENTS_DIR="$INFRA_DIR/clients"
REGISTRY="$CLIENTS_DIR/registry.json"
TEMPLATE="$INFRA_DIR/templates/client.yml"

# GHCR image settings
GHCR_OWNER="${GHCR_OWNER:-}"
IMAGE_REPO="ghcr.io/${GHCR_OWNER}/agentcenter-app"

# Ensure registry exists
[ -f "$REGISTRY" ] || echo '{}' > "$REGISTRY"

# Load shared env
if [ -f "$INFRA_DIR/.env" ]; then
  set -a; source "$INFRA_DIR/.env"; set +a
fi

# ── Helpers ──────────────────────────────────────────────────────────

red()   { printf "\033[0;31m%s\033[0m\n" "$*"; }
green() { printf "\033[0;32m%s\033[0m\n" "$*"; }
bold()  { printf "\033[1m%s\033[0m\n" "$*"; }

die() { red "Error: $*" >&2; exit 1; }

require_slug() {
  [ -n "${1:-}" ] || die "Usage: $0 $COMMAND <slug>"
  [[ "$1" =~ ^[a-z][a-z0-9-]*$ ]] || die "Slug must be lowercase alphanumeric with hyphens (e.g. acme, my-client)"
  echo "$1"
}

compose() {
  local args=("--project-directory" "$HOST_INFRA_DIR" "-f" "$INFRA_DIR/docker-compose.yml")
  for f in "$CLIENTS_DIR"/*.yml; do
    [ -f "$f" ] && args+=("-f" "$f")
  done
  docker compose "${args[@]}" "$@"
}

compose_client() {
  local slug="$1"; shift
  COMPOSE_IGNORE_ORPHANS=true \
    docker compose --project-directory "$HOST_INFRA_DIR" -f "$INFRA_DIR/docker-compose.yml" -f "$CLIENTS_DIR/$slug.yml" "$@"
}

ghcr_login() {
  [ -n "${GHCR_TOKEN:-}" ] || die "GHCR_TOKEN not set in .env"
  [ -n "${GHCR_USER:-}" ] || die "GHCR_USER not set in .env"
  echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USER" --password-stdin 2>/dev/null
}

resolve_image() {
  local version="${1:-latest}"
  if [ -n "$GHCR_OWNER" ]; then
    echo "${IMAGE_REPO}:${version}"
  else
    echo "agentcenter-app:${version}"
  fi
}

# Insert Traefik labels for a custom domain into a compose file.
# Labels are inserted before the # END_LABELS placeholder so the file stays valid YAML.
insert_domain_labels() {
  local file="$1" router_name="$2" domain="$3"
  local tmp
  tmp=$(mktemp)
  awk -v router="$router_name" -v domain="$domain" '
    /      # END_LABELS/ {
      print "      - traefik.http.routers." router ".rule=Host(`" domain "`)"
      print "      - traefik.http.routers." router ".entrypoints=websecure"
      print "      - traefik.http.routers." router ".tls.certresolver=letsencrypt"
      print "      - traefik.http.services." router ".loadbalancer.server.port=3000"
    }
    { print }
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# ── Commands ─────────────────────────────────────────────────────────

cmd_create() {
  local slug name version="latest"
  slug=$(require_slug "${1:-}")
  shift
  name="$slug"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --version) version="$2"; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  [ -f "$CLIENTS_DIR/$slug.yml" ] && die "Client '$slug' already exists"
  [ -n "${PG_PASS:-}" ] || die "PG_PASS not set. Create infra/.env from .env.example"

  local image
  image=$(resolve_image "$version")

  bold "Creating client: $slug (image: $image)"

  # 1. Pull image from GHCR if configured
  if [ -n "$GHCR_OWNER" ]; then
    echo "  Pulling image $image..."
    ghcr_login
    docker pull "$image"
  fi

  # 2. Create database
  echo "  Creating database client_$slug..."
  docker compose --project-directory "$HOST_INFRA_DIR" -f "$INFRA_DIR/docker-compose.yml" exec -T postgres \
    psql -U postgres -c "CREATE DATABASE client_$slug;" 2>/dev/null || true

  # 3. Generate secrets
  local auth_secret cron_secret
  auth_secret=$(openssl rand -hex 32)
  cron_secret=$(openssl rand -hex 32)

  # 4. Issue license
  local license_refresh_token
  echo "  Issuing license..."
  license_refresh_token=$(issue_license_token "$slug" "$name" "starter")
  if [ "$license_refresh_token" = "__PENDING__" ]; then
    echo "  Warning: Could not issue license — run './ac issue-license $slug starter' after dashboard is up"
  else
    echo "  License issued (starter plan)"
  fi

  # 5. Generate compose file from template
  echo "  Generating compose file..."
  sed -e "s/__SLUG__/$slug/g" \
      -e "s/__AUTH_SECRET__/$auth_secret/g" \
      -e "s/__CRON_SECRET__/$cron_secret/g" \
      -e "s|__IMAGE__|$image|g" \
      -e "s|__LICENSE_REFRESH_TOKEN__|$license_refresh_token|g" \
      "$TEMPLATE" > "$CLIENTS_DIR/$slug.yml"

  # 6. Update registry
  local tmp
  tmp=$(mktemp)
  jq --arg slug "$slug" \
     --arg name "$name" \
     --arg auth "$auth_secret" \
     --arg cron "$cron_secret" \
     --arg date "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
     --arg ver "$version" \
     --arg lic "$license_refresh_token" \
     --arg plan "starter" \
     '.[$slug] = {name: $name, type: "hosted", provisioningStatus: "provisioning", provisioningAttempts: 1, authSecret: $auth, cronSecret: $cron, licenseRefreshToken: $lic, createdAt: $date, domains: [], version: $ver, plan: $plan}' \
     "$REGISTRY" > "$tmp" && cat "$tmp" > "$REGISTRY" && rm -f "$tmp"

  # 7. Start the container
  echo "  Starting container..."
  compose_client "$slug" up -d "app-$slug"

  # 8. Seed default feature flags
  echo "  Seeding feature flags..."
  seed_feature_flags "$slug"

  # 9. Enforce starter plan limits (seed inserts everything as true; sync corrects it)
  echo "  Applying starter plan limits..."
  sync_plan_flags "$slug" "starter"

  green "Client '$slug' created!"
  echo "  URL: https://$slug.app.agentcenter.cloud"
  echo "  DB:  client_$slug"
  echo "  Ver: $version"
}

cmd_delete() {
  local slug confirm=false force=false
  slug=$(require_slug "${1:-}")
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --confirm) confirm=true; shift ;;
      --force)   force=true; shift ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  # Allow --force to delete an orphaned DB/registry entry even when the .yml is missing.
  # Normal path requires the .yml to exist.
  if [ "$force" != true ]; then
    [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found. Use --force to remove an orphaned registry entry or database."
  fi

  if [ "$confirm" != true ]; then
    die "This will delete the database and all data. Pass --confirm to proceed."
  fi

  bold "Deleting client: $slug"

  # 1. Stop and remove container (best-effort — may not exist if yml is missing)
  echo "  Stopping container..."
  if [ -f "$CLIENTS_DIR/$slug.yml" ]; then
    compose_client "$slug" stop "app-$slug" 2>/dev/null || true
    compose_client "$slug" rm -f "app-$slug" 2>/dev/null || true
  else
    docker stop "agentcenter-app-${slug}-1" 2>/dev/null || true
    docker rm   "agentcenter-app-${slug}-1" 2>/dev/null || true
  fi

  # 2. Remove client data volume
  echo "  Removing data volume..."
  local vol
  vol=$(docker volume ls -q --filter "name=app_data__${slug}" 2>/dev/null | head -1)
  if [ -n "$vol" ]; then
    docker volume rm "$vol" 2>/dev/null || echo "  Warning: could not remove volume $vol — remove manually"
  fi

  # 3. Rename database to free up the slug (keeps data as backup)
  local ts
  ts=$(date -u +%Y%m%d%H%M%S)
  echo "  Renaming database client_$slug → deleted_${slug}_${ts}..."
  if ! docker compose --project-directory "$HOST_INFRA_DIR" -f "$INFRA_DIR/docker-compose.yml" exec -T postgres \
    psql -U postgres -c "ALTER DATABASE client_$slug RENAME TO deleted_${slug}_${ts};" 2>/dev/null; then
    echo "  Warning: Could not rename database (may not exist or has active connections)."
    echo "  If the DB exists: ALTER DATABASE client_$slug RENAME TO deleted_${slug}_${ts};"
  fi

  # 4. Remove compose file
  rm -f "$CLIENTS_DIR/$slug.yml"

  # 5. Archive registry entry (rename key to deleted_<slug>_<ts> for audit trail)
  local deleted_key="deleted_${slug}_${ts}"
  local tmp
  tmp=$(mktemp)
  jq --arg slug "$slug" --arg key "$deleted_key" \
    'if has($slug) then (.[$key] = .[$slug] | del(.[$slug])) else . end' \
    "$REGISTRY" > "$tmp" && cat "$tmp" > "$REGISTRY" && rm -f "$tmp"

  green "Client '$slug' deleted. Registry entry archived as '$deleted_key'."
}

cmd_list() {
  bold "Clients:"
  if [ "$(jq 'length' "$REGISTRY")" -eq 0 ]; then
    echo "  (none)"
    return
  fi

  printf "  %-20s %-25s %-10s %-12s %s\n" "SLUG" "NAME" "STATUS" "PLAN" "CREATED"
  printf "  %-20s %-25s %-10s %-12s %s\n" "----" "----" "------" "----" "-------"

  for slug in $(jq -r 'keys[] | select(startswith("deleted_") | not)' "$REGISTRY"); do
    local name created plan status cid
    name=$(jq -r ".\"$slug\".name" "$REGISTRY")
    created=$(jq -r ".\"$slug\".createdAt" "$REGISTRY")
    plan=$(jq -r ".\"$slug\".plan // \"unknown\"" "$REGISTRY")
    # Use exact name match: Docker prepends / to container names internally
    cid=$(docker ps -aq --filter "name=^/app-${slug}$" 2>/dev/null | head -1)
    if [ -n "$cid" ]; then
      status=$(docker inspect --format='{{.State.Status}}' "$cid" 2>/dev/null || echo "unknown")
    else
      status="stopped"
    fi
    printf "  %-20s %-25s %-10s %-12s %s\n" "$slug" "$name" "$status" "$plan" "$created"
  done
}

cmd_logs() {
  local slug
  slug=$(require_slug "${1:-}")
  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"
  compose_client "$slug" logs -f "app-$slug"
}

cmd_restart() {
  local slug
  slug=$(require_slug "${1:-}")
  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"
  bold "Restarting $slug..."
  compose_client "$slug" restart "app-$slug"
  green "Done."
}

cmd_fix_migrations() {
  local slug
  slug=$(require_slug "${1:-}")
  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"
  [ -n "${PG_PASS:-}" ] || die "PG_PASS not set"

  local image db pg_url
  image=$(grep "image:" "$CLIENTS_DIR/$slug.yml" | awk '{print $2}' | head -1)
  [ -n "$image" ] || die "Could not determine image for $slug"
  db="client_$slug"
  pg_url="postgresql://postgres:${PG_PASS}@postgres:5432/$db?connection_limit=1&pool_timeout=5"

  bold "Fixing migrations for $slug (image: $image)..."

  local prisma_run="docker run --rm --network agentcenter
    -e POSTGRES_PRISMA_URL=$pg_url
    -e POSTGRES_URL_NON_POOLING=$pg_url
    --entrypoint sh $image -c"
  local prisma_cmd="node /prisma-cli/node_modules/prisma/build/index.js"

  # 1. db push — brings the actual schema in sync with the current Prisma schema.
  #    Additive-only: never drops existing data.
  #    May fail with P1014 when the DB has _prisma_migrations but no actual tables
  #    (bootstrap failure). We capture output to detect that case.
  echo "  Syncing schema to current Prisma model (db push)..."
  local push_out
  push_out=$(docker run --rm --network agentcenter \
    -e POSTGRES_PRISMA_URL="$pg_url" \
    -e POSTGRES_URL_NON_POOLING="$pg_url" \
    --entrypoint sh "$image" \
    -c "$prisma_cmd db push --skip-generate --accept-data-loss 2>&1" || true)
  echo "$push_out"

  # P1014 means _prisma_migrations exists but application tables are missing —
  # Prisma aborts db push because it can't introspect a partially-bootstrapped DB.
  # Fix: reset migration history so migrate deploy re-runs all migrations from scratch.
  if echo "$push_out" | grep -q "P1014"; then
    echo "  Detected P1014 (missing application tables) — resetting migration history..."
    docker compose --project-directory "$HOST_INFRA_DIR" -f "$INFRA_DIR/docker-compose.yml" \
      exec -T postgres psql -U postgres -d "$db" \
      -c "DELETE FROM _prisma_migrations; DROP TABLE IF EXISTS feature_flags CASCADE;" \
      2>/dev/null || true
    echo "  Migration history cleared — migrate deploy will re-apply all migrations."
  fi

  # 2. Resolve ALL failed/in-progress migrations as applied.
  #    After db push the schema is correct, so any migration that was stuck
  #    (P3009/P3018) — including ones that failed because a table didn't exist yet —
  #    can be safely marked applied rather than re-run (db push already applied them).
  #    Skip this step if we just cleared history (all migrations need to run fresh).
  if ! echo "$push_out" | grep -q "P1014"; then
    echo "  Resolving any failed migrations as applied..."
    local failed_list
    failed_list=$(docker compose --project-directory "$HOST_INFRA_DIR" -f "$INFRA_DIR/docker-compose.yml" \
      exec -T postgres psql -U postgres -d "$db" -t -A \
      -c "SELECT migration_name FROM _prisma_migrations WHERE finished_at IS NULL AND rolled_back_at IS NULL" \
      2>/dev/null || true)
    if [ -n "$failed_list" ]; then
      echo "$failed_list" | while IFS= read -r m; do
        [ -z "$m" ] && continue
        echo "    Marking as applied: $m"
        docker run --rm --network agentcenter \
          -e POSTGRES_PRISMA_URL="$pg_url" \
          -e POSTGRES_URL_NON_POOLING="$pg_url" \
          --entrypoint sh "$image" \
          -c "$prisma_cmd migrate resolve --applied \"$m\" 2>/dev/null || true"
      done
    else
      echo "  No failed migrations."
    fi
  fi

  # 3. Run migrate deploy — applies any pending/never-run migrations.
  echo "  Running migrate deploy..."
  docker run --rm --network agentcenter \
    -e POSTGRES_PRISMA_URL="$pg_url" \
    -e POSTGRES_URL_NON_POOLING="$pg_url" \
    --entrypoint sh "$image" \
    -c "$prisma_cmd migrate deploy"

  # 4. Seed feature flags (ON CONFLICT DO NOTHING — safe for existing clients)
  echo "  Seeding feature flags..."
  seed_feature_flags "$slug"
  local plan
  plan=$(jq -r ".\"$slug\".plan // \"starter\"" "$REGISTRY")
  sync_plan_flags "$slug" "$plan"

  # 5. Restart container
  echo "  Restarting container..."
  compose_client "$slug" up -d "app-$slug"

  green "Migration fix complete for $slug."
}

cmd_add_domain() {
  local slug domain
  slug=$(require_slug "${1:-}")
  domain="${2:-}"
  [ -n "$domain" ] || die "Usage: $0 add-domain <slug> <domain>"
  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"

  # Check for duplicate domain
  local already
  already=$(jq -r ".\"$slug\".domains // [] | .[]" "$REGISTRY" | grep -Fx "$domain" || true)
  [ -n "$already" ] && die "Domain '$domain' is already added to $slug"

  bold "Adding domain $domain to $slug..."

  # router_name must be unique and valid: replace dots and underscores with hyphens
  local router_name
  router_name=$(echo "$domain" | tr '._' '-')

  # Insert labels into the labels section before the END_LABELS placeholder
  insert_domain_labels "$CLIENTS_DIR/$slug.yml" "$router_name" "$domain"

  # Update registry
  local tmp
  tmp=$(mktemp)
  jq --arg slug "$slug" --arg domain "$domain" \
     '.[$slug].domains += [$domain]' "$REGISTRY" > "$tmp" && cat "$tmp" > "$REGISTRY" && rm -f "$tmp"

  # Restart to pick up new labels
  compose_client "$slug" up -d "app-$slug"
  green "Domain $domain added. Make sure DNS points to this server."
}

cmd_update() {
  local target="${1:---all}"

  if [ -n "$GHCR_OWNER" ]; then
    bold "Pulling latest image from GHCR..."
    ghcr_login
    docker pull "${IMAGE_REPO}:latest"
  else
    bold "Building latest image..."
    docker build -t agentcenter-app:latest "$INFRA_DIR/../app"
  fi

  if [ "$target" = "--all" ]; then
    bold "Restarting all clients..."
    for slug in $(jq -r 'keys[] | select(startswith("deleted_") | not)' "$REGISTRY"); do
      echo "  Updating $slug..."
      compose_client "$slug" up -d "app-$slug"
      seed_feature_flags "$slug"
      local plan
      plan=$(jq -r ".\"$slug\".plan // empty" "$REGISTRY")
      if [ -n "$plan" ]; then
        sync_plan_flags "$slug" "$plan"
      else
        echo "  Warning: no plan set for $slug — skipping flag sync. Run './ac set-plan $slug <plan>' to fix."
      fi
    done
  else
    local slug
    slug=$(require_slug "$target")
    [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"
    echo "  Updating $slug..."
    compose_client "$slug" up -d "app-$slug"
    seed_feature_flags "$slug"
    local plan
    plan=$(jq -r ".\"$slug\".plan // empty" "$REGISTRY")
    if [ -n "$plan" ]; then
      sync_plan_flags "$slug" "$plan"
    else
      echo "  Warning: no plan set for $slug — skipping flag sync. Run './ac set-plan $slug <plan>' to fix."
    fi
  fi

  green "Update complete."
}

cmd_upgrade() {
  local slug version=""
  slug=$(require_slug "${1:-}")
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version) version="$2"; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  [ -n "$version" ] || die "Usage: $0 upgrade <slug> --version <tag>"
  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"

  local image
  image=$(resolve_image "$version")

  bold "Upgrading $slug to $image..."

  # 1. Pull the new image
  if [ -n "$GHCR_OWNER" ]; then
    ghcr_login
  fi
  docker pull "$image"

  # 2. Regenerate compose file with new image
  echo "  Regenerating compose file..."
  regenerate_compose "$slug" "$image"

  # 3. Update version in registry
  local tmp
  tmp=$(mktemp)
  jq --arg slug "$slug" --arg ver "$version" \
     '.[$slug].version = $ver' \
     "$REGISTRY" > "$tmp" && cat "$tmp" > "$REGISTRY" && rm -f "$tmp"

  # 4. Restart container with new image
  echo "  Restarting container..."
  compose_client "$slug" up -d "app-$slug"

  # 5. Seed any missing feature flags — non-fatal: the container may still be
  #    running migrations immediately after start, so psql can fail momentarily.
  echo "  Seeding new feature flags..."
  seed_feature_flags "$slug" || echo "  Warning: flag seeding failed (container may still be migrating — re-run fix-migrations if needed)"

  # 6. Re-enforce plan limits so new flags get the correct enabled state
  echo "  Syncing plan flags..."
  local plan
  plan=$(jq -r ".\"$slug\".plan // empty" "$REGISTRY")
  if [ -n "$plan" ]; then
    sync_plan_flags "$slug" "$plan" || true
  else
    echo "  Warning: no plan set for $slug — skipping flag sync. Run './ac set-plan $slug <plan>' to fix."
  fi

  green "Client '$slug' upgraded to version $version"
}

regenerate_compose() {
  local slug="$1" image="$2"
  local auth_secret cron_secret license_refresh_token

  auth_secret=$(jq -r ".\"$slug\".authSecret // empty" "$REGISTRY")
  cron_secret=$(jq -r ".\"$slug\".cronSecret // empty" "$REGISTRY")
  [ -n "$auth_secret" ] || die "Missing authSecret for '$slug' in registry — registry may be corrupt"
  [ -n "$cron_secret" ] || die "Missing cronSecret for '$slug' in registry — registry may be corrupt"

  license_refresh_token=$(jq -r ".\"$slug\".licenseRefreshToken // \"__PENDING__\"" "$REGISTRY")

  # Auto-issue license for hosted clients that don't have one yet
  if [ "$license_refresh_token" = "__PENDING__" ] || [ -z "$license_refresh_token" ]; then
    local name
    name=$(jq -r ".\"$slug\".name // \"$slug\"" "$REGISTRY")
    echo "  No license found — issuing starter license..."
    license_refresh_token=$(issue_license_token "$slug" "$name" "starter")
    if [ "$license_refresh_token" != "__PENDING__" ]; then
      local tmp
      tmp=$(mktemp)
      jq --arg slug "$slug" --arg lic "$license_refresh_token" \
         '.[$slug].licenseRefreshToken = $lic' \
         "$REGISTRY" > "$tmp" && cat "$tmp" > "$REGISTRY" && rm -f "$tmp"
      echo "  License issued (starter plan)"
    else
      echo "  Warning: Could not issue license"
    fi
  fi

  sed -e "s/__SLUG__/$slug/g" \
      -e "s/__AUTH_SECRET__/$auth_secret/g" \
      -e "s/__CRON_SECRET__/$cron_secret/g" \
      -e "s|__IMAGE__|$image|g" \
      -e "s|__LICENSE_REFRESH_TOKEN__|$license_refresh_token|g" \
      "$TEMPLATE" > "$CLIENTS_DIR/$slug.yml"

  # Re-apply custom domains if any — inserted into the labels section
  local domains
  domains=$(jq -r ".\"$slug\".domains // [] | .[]" "$REGISTRY")
  for domain in $domains; do
    local router_name
    router_name=$(echo "$domain" | tr '._' '-')
    insert_domain_labels "$CLIENTS_DIR/$slug.yml" "$router_name" "$domain"
  done
}

cmd_refresh_env() {
  local target="${1:---all}"

  if [ "$target" = "--all" ]; then
    bold "Refreshing env for all clients..."
    for slug in $(jq -r 'keys[] | select(startswith("deleted_") | not)' "$REGISTRY"); do
      local version image
      version=$(jq -r ".\"$slug\".version // \"latest\"" "$REGISTRY")
      image=$(resolve_image "$version")
      echo "  Regenerating $slug..."
      regenerate_compose "$slug" "$image"
      compose_client "$slug" up -d "app-$slug"
    done
  else
    local slug
    slug=$(require_slug "$target")
    [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"
    local version image
    version=$(jq -r ".\"$slug\".version // \"latest\"" "$REGISTRY")
    image=$(resolve_image "$version")
    bold "Refreshing env for $slug..."
    regenerate_compose "$slug" "$image"
    compose_client "$slug" up -d "app-$slug"
  fi

  green "Environment refreshed."
}

cmd_status() {
  bold "System Status:"
  echo ""

  echo "  Containers:"
  docker ps --format "  {{.Names}}\t{{.Status}}\t{{.Ports}}" --filter "network=agentcenter" 2>/dev/null || echo "  (none running)"
  echo ""

  echo "  Memory Usage:"
  docker stats --no-stream --format "  {{.Name}}\t{{.MemUsage}}" --filter "network=agentcenter" 2>/dev/null || true
  echo ""

  echo "  Clients: $(jq 'length' "$REGISTRY")"
  echo "  Disk (PG volume):"
  docker system df -v 2>/dev/null | grep "agentcenter_pg_data" || echo "  (not found)"
}

psql_client() {
  local slug="$1"; shift
  docker compose --project-directory "$HOST_INFRA_DIR" -f "$INFRA_DIR/docker-compose.yml" exec -T postgres \
    psql -U postgres -d "client_$slug" "$@"
}

seed_feature_flags() {
  local slug="$1"
  local config="$INFRA_DIR/scripts/plan-config.json"

  # Create the feature_flags table if it doesn't exist yet.
  psql_client "$slug" -c "
    CREATE TABLE IF NOT EXISTS feature_flags (
      id TEXT PRIMARY KEY,
      key TEXT UNIQUE NOT NULL,
      enabled BOOLEAN NOT NULL DEFAULT false,
      \"managedBy\" TEXT NOT NULL DEFAULT 'system',
      description TEXT,
      \"updatedAt\" TIMESTAMP(3) NOT NULL DEFAULT NOW()
    );
  " 2>/dev/null

  # Insert any flags not yet in the DB (ON CONFLICT DO NOTHING preserves existing state).
  # Note: enabled=true here is intentional — sync_plan_flags is always called after seeding
  # to correct the enabled state according to the client's plan.
  if [ -f "$config" ]; then
    local insert_sql
    insert_sql=$(jq -r '
      .allFeatures | map(
        "(gen_random_uuid()::text, \(.key | @json), true, \(.managedBy | @json), \(.description | @json), NOW())"
      ) | join(",\n      ")
    ' "$config")

    psql_client "$slug" -c "
      INSERT INTO feature_flags (id, key, enabled, \"managedBy\", description, \"updatedAt\") VALUES
      $insert_sql
      ON CONFLICT (key) DO NOTHING;
    " 2>/dev/null
  fi
}

notify_flag_change() {
  local slug="$1"
  local cron_secret
  cron_secret=$(jq -r ".\"$slug\".cronSecret" "$REGISTRY")
  # Invalidate the app's in-memory flag cache via REST endpoint.
  # compose_client ensures app-$slug service is resolvable (it's defined in the client yml).
  compose_client "$slug" exec -T "app-$slug" \
    wget -qO- --header="Authorization: Bearer $cron_secret" --post-data="" \
    http://127.0.0.1:3000/api/feature-flags/invalidate 2>/dev/null || true
}

cmd_features() {
  local slug
  slug=$(require_slug "${1:-}")
  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"

  bold "Feature flags for $slug:"
  printf "  %-25s %-10s %-10s %s\n" "KEY" "STATUS" "MANAGED" "DESCRIPTION"
  printf "  %-25s %-10s %-10s %s\n" "---" "------" "-------" "-----------"

  psql_client "$slug" -t -A -c \
    "SELECT key, enabled, COALESCE(\"managedBy\", 'system'), COALESCE(description, '') FROM feature_flags ORDER BY key" 2>/dev/null \
  | while IFS='|' read -r key enabled managed desc; do
      local status
      if [ "$enabled" = "t" ]; then status="enabled"; else status="disabled"; fi
      printf "  %-25s %-10s %-10s %s\n" "$key" "$status" "$managed" "$desc"
    done
}

cmd_enable() {
  local slug feature
  slug=$(require_slug "${1:-}")
  feature="${2:-}"
  [ -n "$feature" ] || die "Usage: $0 enable <slug> <feature>"
  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"

  local rows
  rows=$(psql_client "$slug" -t -A -v key="$feature" -c "
    WITH upd AS (
      UPDATE feature_flags SET enabled = true, \"updatedAt\" = NOW()
      WHERE key = :'key' RETURNING 1
    ) SELECT COUNT(*) FROM upd;
  " 2>/dev/null || echo "0")

  [ "${rows:-0}" -eq 0 ] && die "Feature '$feature' not found for client '$slug'"

  notify_flag_change "$slug"
  green "Feature '$feature' enabled for $slug"
}

cmd_disable() {
  local slug feature
  slug=$(require_slug "${1:-}")
  feature="${2:-}"
  [ -n "$feature" ] || die "Usage: $0 disable <slug> <feature>"
  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"

  local rows
  rows=$(psql_client "$slug" -t -A -v key="$feature" -c "
    WITH upd AS (
      UPDATE feature_flags SET enabled = false, \"updatedAt\" = NOW()
      WHERE key = :'key' RETURNING 1
    ) SELECT COUNT(*) FROM upd;
  " 2>/dev/null || echo "0")

  [ "${rows:-0}" -eq 0 ] && die "Feature '$feature' not found for client '$slug'"

  notify_flag_change "$slug"
  green "Feature '$feature' disabled for $slug"
}

# Sync DB feature flags to match a license plan.
# Reads plan features from the central plan-config.json.
# Enables flags included in the plan, disables the rest (system-managed only).
sync_plan_flags() {
  local slug="$1" plan="$2"
  local config="$INFRA_DIR/scripts/plan-config.json"

  if [ ! -f "$config" ]; then
    echo "  Warning: plan-config.json not found, skipping flag sync"
    return 1
  fi

  local features_csv
  features_csv=$(jq -r ".plans.\"$plan\".features // [] | map(\"'\" + . + \"'\") | join(\",\")" "$config")

  if [ -z "$features_csv" ]; then
    echo "  Warning: No features found for plan '$plan'"
    return 1
  fi

  # Enable flags in the plan, disable the rest — system-managed flags only.
  # User-managed flags are left untouched so users retain manual control.
  psql_client "$slug" -c "
    UPDATE feature_flags
    SET enabled = (key IN ($features_csv)), \"updatedAt\" = NOW()
    WHERE \"managedBy\" = 'system';
  " 2>/dev/null

  notify_flag_change "$slug"
}

cmd_set_plan() {
  local slug plan
  slug=$(require_slug "${1:-}")
  plan="${2:-}"
  [ -n "$plan" ] || die "Usage: $0 set-plan <slug> <starter|pro|enterprise>"
  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"
  [[ "$plan" =~ ^(starter|pro|enterprise)$ ]] || die "Unknown plan: $plan. Use: starter, pro, enterprise"

  # 1. Update license to new plan
  echo "  Updating license..."
  local name
  name=$(jq -r ".\"$slug\".name // \"$slug\"" "$REGISTRY")
  local refresh_token
  refresh_token=$(issue_license_token "$slug" "$name" "$plan")

  # Always persist the new plan in registry, whether or not license issuance succeeded
  local tmp
  tmp=$(mktemp)
  jq --arg slug "$slug" --arg plan "$plan" \
     '.[$slug].plan = $plan' \
     "$REGISTRY" > "$tmp" && cat "$tmp" > "$REGISTRY" && rm -f "$tmp"

  if [ "$refresh_token" != "__PENDING__" ]; then
    # Store new license token in registry
    tmp=$(mktemp)
    jq --arg slug "$slug" --arg lic "$refresh_token" \
       '.[$slug].licenseRefreshToken = $lic' \
       "$REGISTRY" > "$tmp" && cat "$tmp" > "$REGISTRY" && rm -f "$tmp"

    # Regenerate compose with new token and restart
    local version image
    version=$(jq -r ".\"$slug\".version // \"latest\"" "$REGISTRY")
    image=$(resolve_image "$version")
    regenerate_compose "$slug" "$image"
    compose_client "$slug" up -d "app-$slug"
    echo "  License updated to $plan"
  else
    echo "  Warning: Could not update license — only updating feature flags"
  fi

  # 2. Sync feature flags to match plan
  echo "  Syncing feature flags..."
  sync_plan_flags "$slug" "$plan"

  green "Plan '$plan' applied to $slug"
  cmd_features "$slug"
}

# ── License Helpers ──────────────────────────────────────────────────

# Issue a license token using the Node.js helper script.
# Runs inside the dashboard container which has the RSA keys and registry.
# Returns the refresh token or "__PENDING__" on failure.
issue_license_token() {
  local slug="$1" org="$2" plan="${3:-starter}"

  local result
  if result=$(compose exec -T dashboard node /app/scripts/issue-license.js "$slug" "$org" "$plan" 2>/dev/null); then
    echo "$result" | jq -r '.refreshToken // "__PENDING__"'
  else
    echo "__PENDING__"
  fi
}

cmd_issue_license() {
  local slug plan
  slug=$(require_slug "${1:-}")
  plan="${2:-starter}"

  [ -f "$CLIENTS_DIR/$slug.yml" ] || die "Client '$slug' not found"
  [[ "$plan" =~ ^(starter|pro|enterprise)$ ]] || die "Invalid plan: $plan. Use: starter, pro, enterprise"

  local name
  name=$(jq -r ".\"$slug\".name // \"$slug\"" "$REGISTRY")

  bold "Issuing $plan license for $slug..."

  local refresh_token
  refresh_token=$(issue_license_token "$slug" "$name" "$plan")

  if [ "$refresh_token" = "__PENDING__" ]; then
    die "Failed to issue license. Make sure the dashboard container is running."
  fi

  # Update registry with the refresh token and plan
  local tmp
  tmp=$(mktemp)
  jq --arg slug "$slug" --arg lic "$refresh_token" --arg plan "$plan" \
     '.[$slug].licenseRefreshToken = $lic | .[$slug].plan = $plan' \
     "$REGISTRY" > "$tmp" && cat "$tmp" > "$REGISTRY" && rm -f "$tmp"

  # Check client type (hosted vs self-hosted)
  local client_type
  client_type=$(jq -r ".\"$slug\".type // \"hosted\"" "$REGISTRY")

  if [ "$client_type" = "self-hosted" ]; then
    echo ""
    green "License issued for self-hosted client '$slug'"
    echo ""
    bold "Give this token to the client to activate:"
    echo ""
    echo "  $refresh_token"
    echo ""
  else
    # Hosted: inject token into compose and restart
    echo "  Regenerating compose file..."
    local version image
    version=$(jq -r ".\"$slug\".version // \"latest\"" "$REGISTRY")
    image=$(resolve_image "$version")
    regenerate_compose "$slug" "$image"

    echo "  Restarting container..."
    compose_client "$slug" up -d "app-$slug"

    green "License issued and applied for hosted client '$slug'"
    echo "  Plan: $plan"
    echo "  The container will auto-activate on startup."
  fi

  # Sync feature flags to match the plan
  echo "  Syncing feature flags to $plan plan..."
  sync_plan_flags "$slug" "$plan"
}

cmd_orphans() {
  local fix=false confirm=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix)     fix=true; shift ;;
      --confirm) confirm=true; shift ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  bold "Checking for registry/database drift..."

  # Slugs in registry
  local registry_slugs db_slugs
  registry_slugs=$(jq -r 'keys[] | select(startswith("deleted_") | not)' "$REGISTRY" 2>/dev/null || true)

  # client_* databases actually in postgres (exclude deleted_* soft-deleted DBs)
  db_slugs=$(docker compose --project-directory "$HOST_INFRA_DIR" -f "$INFRA_DIR/docker-compose.yml" \
    exec -T postgres psql -U postgres -t -A \
    -c "SELECT datname FROM pg_database WHERE datname LIKE 'client_%' ORDER BY datname" \
    2>/dev/null | sed 's/^client_//' || true)

  local orphan_dbs=()   # DB exists, no registry entry
  local orphan_reg=()   # Registry entry, no DB

  # Check each registry entry has a matching DB
  while IFS= read -r slug; do
    [ -z "$slug" ] && continue
    if ! echo "$db_slugs" | grep -qx "$slug"; then
      orphan_reg+=("$slug")
    fi
  done <<< "$registry_slugs"

  # Check each DB has a matching registry entry
  while IFS= read -r slug; do
    [ -z "$slug" ] && continue
    if ! echo "$registry_slugs" | grep -qx "$slug"; then
      orphan_dbs+=("$slug")
    fi
  done <<< "$db_slugs"

  if [ ${#orphan_reg[@]} -eq 0 ] && [ ${#orphan_dbs[@]} -eq 0 ]; then
    green "No drift detected — registry and databases are in sync."
    return 0
  fi

  if [ ${#orphan_reg[@]} -gt 0 ]; then
    echo ""
    red "Registry entries with NO database (${#orphan_reg[@]}):"
    for slug in "${orphan_reg[@]}"; do
      echo "  - $slug  (registry + yml exist, database missing)"
    done
    echo "  → These clients will fail to start. Run './ac delete $slug --confirm' to remove, or recreate the DB."
  fi

  if [ ${#orphan_dbs[@]} -gt 0 ]; then
    echo ""
    red "Databases with NO registry entry (${#orphan_dbs[@]}):"
    for slug in "${orphan_dbs[@]}"; do
      echo "  - client_$slug  (database exists, no registry/compose entry)"
    done
    echo "  → Orphaned databases. Run './ac delete $slug --force --confirm' to clean up."
  fi

  if [ "$fix" = true ]; then
    if [ "$confirm" != true ]; then
      die "Pass --confirm to apply fixes (orphaned DBs and registry entries will be soft-deleted/archived)."
    fi
    local fix_ts
    fix_ts=$(date -u +%Y%m%d%H%M%S)
    for slug in "${orphan_dbs[@]}"; do
      echo "  Archiving orphaned database for: $slug"
      cmd_delete "$slug" --force --confirm
    done
    for slug in "${orphan_reg[@]}"; do
      # Registry entry exists but DB is gone — archive yml + registry entry with timestamp
      echo "  Archiving registry entry with no database: $slug"
      local deleted_key="deleted_${slug}_${fix_ts}"
      if [ -f "$CLIENTS_DIR/$slug.yml" ]; then
        mv "$CLIENTS_DIR/$slug.yml" "$CLIENTS_DIR/${deleted_key}.yml"
        echo "    Compose file archived: ${deleted_key}.yml"
      fi
      local tmp; tmp=$(mktemp)
      jq --arg slug "$slug" --arg key "$deleted_key" \
        'if has($slug) then (.[$key] = .[$slug] | del(.[$slug])) else . end' \
        "$REGISTRY" > "$tmp" && cat "$tmp" > "$REGISTRY" && rm -f "$tmp"
      echo "    Registry entry archived as: $deleted_key"
    done
    green "Drift cleanup complete. All data soft-deleted (renamed, not dropped)."
  fi
}

cmd_help() {
  cat <<'EOF'
AgentCenter.Cloud — Per-Client Deployment CLI

Usage: ./ac <command> [args]

Commands:
  create <slug> [--name "Name"] [--version <tag>]
                                  Provision a new client
  delete <slug> --confirm         Remove a client and its database
  list                            List all clients and their status
  logs <slug>                     Tail logs for a client
  restart <slug>                  Restart a client container
  add-domain <slug> <domain>      Add a custom domain to a client
  update [slug|--all]             Pull latest image and restart clients
  upgrade <slug> --version <tag>  Upgrade a client to a specific version
  refresh-env [slug|--all]        Regenerate compose files with latest env vars
  status                          Show system resource usage

  fix-migrations <slug>           Resolve failed/pending migrations and seed feature flags
                                    Safe for healthy clients (idempotent)

  orphans                         Detect registry/database drift:
                                    • Registry entries with no database
                                    • Databases with no registry entry
                                  Use --fix to remove orphaned entries (with --confirm)

  issue-license <slug> [plan]     Issue a license (starter|pro|enterprise)
                                    Hosted: injects token and restarts container
                                    Self-hosted: prints token to give to client

  features <slug>                 List feature flags for a client
  enable <slug> <feature>         Enable a feature for a client
  disable <slug> <feature>        Disable a feature for a client
  set-plan <slug> <plan>          Change plan (starter|pro|enterprise)
                                    Updates license + feature flags together

  help                            Show this help message

Examples:
  ./ac create acme --name "Acme Corp" --version 1.2.0
  ./ac list
  ./ac logs acme
  ./ac update --all
  ./ac upgrade acme --version 1.3.0
  ./ac add-domain acme app.acmecorp.com
  ./ac features acme
  ./ac enable acme analytics
  ./ac disable acme cloud_vms
  ./ac set-plan acme pro
  ./ac delete acme --confirm
EOF
}

# ── Main ─────────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  create)        cmd_create "$@" ;;
  delete)        cmd_delete "$@" ;;
  list)          cmd_list ;;
  logs)          cmd_logs "$@" ;;
  restart)       cmd_restart "$@" ;;
  fix-migrations) cmd_fix_migrations "$@" ;;
  add-domain)    cmd_add_domain "$@" ;;
  update)        cmd_update "$@" ;;
  upgrade)       cmd_upgrade "$@" ;;
  refresh-env)   cmd_refresh_env "$@" ;;
  status)        cmd_status ;;
  features)      cmd_features "$@" ;;
  enable)        cmd_enable "$@" ;;
  disable)       cmd_disable "$@" ;;
  set-plan)      cmd_set_plan "$@" ;;
  issue-license) cmd_issue_license "$@" ;;
  orphans)       cmd_orphans "$@" ;;
  help|--help|-h) cmd_help ;;
  *) die "Unknown command: $COMMAND. Run './ac help' for usage." ;;
esac
