# ── PostgreSQL ─────────────────────────────────────────────────────
PG_PASS=change-me-strong-password

# ── Let's Encrypt ─────────────────────────────────────────────────
ACME_EMAIL=admin@agentcenter.cloud

# ── Cloudflare R2 Storage ─────────────────────────────────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mnc

# ── Admin Dashboard ──────────────────────────────────────────────
ADMIN_PASSWORD=change-me-strong-password
# Server-to-server API key for the website's Vercel app.
# Must match INFRA_API_KEY in the website Vercel environment variables.
# Generate with: openssl rand -base64 32
API_KEY=change-me-generate-with-openssl-rand-base64-32

# ── GitHub Container Registry ───────────────────────────────────
GHCR_TOKEN=ghp_your-personal-access-token-with-read-packages
GHCR_USER=your-github-username
GHCR_OWNER=your-github-org-or-user

# ── buildbase (SaaSOS) — workspace-per-tenant ──────────────────
# Platform buildbase server used for tenant human auth / SSO and for
# provisioning a per-tenant workspace. Same values for EVERY tenant; injected
# into each client container's env by `ac`/the dashboard.
SAAS_SERVER_URL=https://your-buildbase-server.example.com
SAAS_ORG_ID=your-buildbase-org-id
SAAS_CLIENT_ID=your-buildbase-client-id
# Server-only OAuth client secret (never exposed to the browser).
SAAS_CLIENT_SECRET=your-buildbase-client-secret
#
# SERVICE credential used to CREATE the per-tenant workspace + add the owner.
# A buildbase service session id with create-workspace + add-member permission.
# HARD PREREQUISITE: the org must be in a mode that ALLOWS workspace creation +
# member invites (NOT "personal" mode). Without a valid credential (or with the
# org in personal mode) workspace creation fails and tenants fall back to
# single-tenant (no cross-tenant gate) — re-bind later with `./ac bind-workspace`.
BUILDBASE_SERVICE_SESSION_ID=your-buildbase-service-session-id
#
# Parent-domain cookie enabling shared-cookie SSO across tenant subdomains
# (consumed by the monorepo bridge). Leave as the platform apex domain.
AUTH_COOKIE_DOMAIN=.agentcenter.cloud
#
# Optional overrides if the live buildbase API namespaces workspace routes
# differently than the SDK default (`/api/v1/public/...`). VERIFY before changing.
# SAAS_API_VERSION=v1
# SAAS_API_BASEPATH=public

# ── Push Notifications (optional) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@agentcenter.cloud

# ── Email Notifications via Resend (optional) ──────────────────
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@agentcenter.cloud
