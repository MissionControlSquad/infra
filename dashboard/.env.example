ADMIN_PASSWORD=change-me-strong-password
# Server-to-server API key for the website's Vercel app.
# Generate with: openssl rand -base64 32
# Must match INFRA_API_KEY in the website Vercel environment variables
API_KEY=change-me-generate-with-openssl-rand-base64-32

# buildbase (SaaSOS) — used by the TS workspace-provisioning mirror in local dev.
# In production `ac create` handles workspace creation; these are read here so the
# dashboard's own path (NODE_ENV !== production) can mirror it. See root .env.example.
SAAS_SERVER_URL=https://your-buildbase-server.example.com
BUILDBASE_SERVICE_SESSION_ID=your-buildbase-service-session-id
# Optional route overrides (VERIFY against live buildbase API):
# SAAS_API_VERSION=v1
# SAAS_API_BASEPATH=public
