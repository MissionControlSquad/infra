ADMIN_PASSWORD=change-me-strong-password
# Server-to-server API key for the website's Vercel app.
# Generate with: openssl rand -base64 32
# Must match INFRA_API_KEY in the website Vercel environment variables
API_KEY=change-me-generate-with-openssl-rand-base64-32

# Note: the buildbase workspace id is PASSED IN by the caller (website) in the
# POST /api/clients body and forwarded to `ac create --workspace-id`. The
# dashboard does not call buildbase, so no buildbase credentials are needed here.
# The SAAS_* platform config + AUTH_COOKIE_DOMAIN live in the root infra/.env
# (they are injected into each tenant container by `ac`).
